{
  "name": "syncpad",
  "version": "0.2.0",
  "private": true,
  "description": "SyncPad — carnet numérique connecté, synchronisé en temps réel",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "node build.mjs",
    "dev": "node build.mjs --watch & node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning tests/sync.test.mjs",
    "test:e2e": "node --disable-warning=ExperimentalWarning tests/e2e.test.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.23.0",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-indexeddb": "^9.0.12"
  }
}
